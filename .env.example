# Copy to .env before starting the API or Docker Compose.
# These values are local examples. Do not put production secrets here.

APP_ENV=development
APP_NAME=enterprise-api
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HS256 signing secret for access tokens. Change before production use.
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE=24h

# Request protection applies inside this API process. Rate limit is per client IP.
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_RATE_LIMIT_RPS=50
HTTP_RATE_LIMIT_BURST=100

# Alert thresholds. A percent of 0 disables that capacity alert.
MONITOR_WINDOW=5m
MONITOR_ERROR_COUNT=20
MONITOR_TIMEOUT_COUNT=1
MONITOR_P95=2s
MONITOR_CPU_PERCENT=90
MONITOR_MEMORY_PERCENT=90
MONITOR_DISK_PERCENT=90

NGINX_PORT=8088

# Copy to .env before starting the API or Docker Compose.
# These values are local examples. Do not put production secrets here.

APP_ENV=development
APP_NAME=enterprise-api
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HS256 signing secret for access tokens. Change before production use.
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE=24h

# SSO / federation (this platform is OIDC/SAML client only; not an OP/IdP).
# SSO_SECRETS_KEY encrypts external IdP Client Secrets and the SAML SP private key.
# SSO_ISSUER is unused (legacy); kept optional for old env files.
# SSO_ISSUER=
SSO_SECRETS_KEY=change-me-sso-secrets-key-32chars
SSO_LOCAL_LOGIN_ENABLED=true
# Optional fallback only. Prefer「身份认证与单点登录」页的前端基址，或登录时自动携带的浏览器地址。
# SSO_FRONTEND_BASE_URL=
# Optional. Auto-created federated users join this tenant.
# Leave empty to use the oldest active tenant (filled by startup bootstrap when the DB is empty).
SSO_DEFAULT_TENANT_ID=

# First-start bootstrap (only when sys_tenants is empty). Unset fields are generated and printed once.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_CODE=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=

# Request protection applies inside this API process. Rate limit is per client IP.
HTTP_READ_TIMEOUT=60s
HTTP_WRITE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=110s
HTTP_MAX_BODY_BYTES=104857600
HTTP_RATE_LIMIT_RPS=50
HTTP_RATE_LIMIT_BURST=100

# Alert thresholds. A percent of 0 disables that capacity alert.
MONITOR_WINDOW=5m
MONITOR_ERROR_COUNT=20
MONITOR_TIMEOUT_COUNT=1
MONITOR_P95=2s
MONITOR_CPU_PERCENT=90
MONITOR_MEMORY_PERCENT=90
MONITOR_DISK_PERCENT=90

NGINX_PORT=8088

# Optional first-start values. After 系统配置 saves address / API Key / 空间 ID, the page is the source of truth.
# WeKnora 0.8.x base URL without /api/v1. The API uses the official Go SDK.
WEKNORA_BASE_URL=http://127.0.0.1:8083
WEKNORA_API_KEY=
WEKNORA_TIMEOUT=30
# WeKnora space id (default 10000). Prefer editing in 系统配置 after first boot.
WEKNORA_TENANT_ID=10000
# HMAC secret for X-External-User-Token (must match WeKnora api-principal-config hmac_secret). Never expose to the browser.
WEKNORA_EXTERNAL_USER_HMAC=
# Short-lived terminal user JWT TTL (seconds or duration). Default 10m, max 24h.
WEKNORA_EXTERNAL_USER_TOKEN_TTL=10m
# Local Ollama download and status. Leave false unless WeKnora can reach Ollama.
WEKNORA_OLLAMA_ENABLED=false
KB_UPLOAD_MAX_FILE_MB=20
KB_UPLOAD_MAX_FILES=20
KB_ZIP_MAX_TOTAL_MB=100
KB_ZIP_MAX_ENTRIES=200
KB_UPLOAD_CONCURRENCY=3
KB_ALLOWED_EXTS=.pdf,.doc,.docx,.txt,.md,.markdown,.csv,.xls,.xlsx,.ppt,.pptx,.html,.htm
KB_WIKI_STATUS_TIMEOUT_MIN=30
